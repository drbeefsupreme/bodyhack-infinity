{
  "name": "bodybuilding-appearance-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "model": "bun scripts/model/build.ts --h 0.0035 --out public/model",
    "model:lite": "bun scripts/model/build.ts --h 0.005 --out public/model-lite",
    "sources": "bun scripts/content/extract-sources.ts",
    "mediapipe": "node scripts/fetch-mediapipe.ts",
    "gate": "node scripts/gate.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && tsc -p server/tsconfig.json",
    "android:build": "scripts/android/build.sh",
    "android:install": "scripts/android/install.sh",
    "android:emulator": "scripts/android/emulator.sh",
    "android:gate": "node scripts/android/gate.ts",
    "android:e2e": "node scripts/android/e2e.ts",
    "android:native-check": "node scripts/android/native-check.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
